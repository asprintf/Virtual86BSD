# files - the machine-independent sources of the kernel, and the devices
# its drivers attach (read by config(8) with arch/MACHINE/conf/files.MACHINE
# and the configuration, GENERIC).
#
#   defopt NAME...                  options a configuration may set (option NAME)
#   device NAME [{loc = default,...}]
#                                   a driver; its children are given the locators
#   attach NAME at PARENT...        where it attaches: the parent drivers, or root.
#                                   The driver defines NAME_cd and NAME_ca
#                                   (struct cfdriver, struct cfattach)
#   file PATH [CONDITION]           a source file, compiled when the CONDITION
#                                   holds: a device in the configuration, an
#                                   option that is set, !, &, | and ( )
#
# (Paths are from sys/.  Files compiled in this order.)

defopt DIAGNOSTIC
defopt COMPAT_LINUX

# buses and devices
device pci {dev = -1, function = -1}
attach pci at mainbus
device pchb
attach pchb at pci
device pcib
attach pcib at pci
device isa {port = -1, iomem = -1, iosiz = 0, irq = -1}
attach isa at pcib
device pciide
attach pciide at pci
device virtio
attach virtio at pci
device vioblk
attach vioblk at virtio
device disk
attach disk at pciide, vioblk
device em
attach em at pci
device com
attach com at isa
device pckbc
attach pckbc at isa
device pckbd
attach pckbd at pckbc
device vga
attach vga at isa
device wskbd
attach wskbd at pckbd
device wsdisplay
attach wsdisplay at vga

