;	sys/compat/linux/syscalls.master - the system calls of the Linux emulation,
;	by Linux's x86-64 numbers (asm/unistd_64.h).
;
;	number	type	{ prototype }
;
;	STD	implemented.  A name starting "sys_" is shared with the native
;		table (kern/syscalls.master); "linux_sys_" is Linux's own,
;		in compat/linux/linux_misc.c.
;	A number that is not listed is not implemented (sys_nosys: ENOSYS).
;
;	Written by kern/makesyscalls.sh into linux_syscall.h, linux_syscallargs.h
;	and linux_sysent.c (sh makesyscalls.sh compat/linux/syscalls.conf).

