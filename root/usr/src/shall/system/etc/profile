# /etc/profile of a Shall system: read by sh at start-up as $ENV
# (chroot.sh sets ENV=/etc/profile).
PATH=/usr/bin:/bin
HOME=${HOME:-/root}
PS1='shall# '
[ "$(id -u)" = 0 ] || PS1='shall$ '
TERM=${TERM:-vt100}
PAGER=more
EDITOR=vi
C17_LIBC=shall     # (c17 built elsewhere, e.g. in a test, defaults to glibc)
export PATH HOME PS1 TERM PAGER EDITOR C17_LIBC
case $- in *i*) [ -r /etc/motd ] && cat /etc/motd ;; esac
