# Shall's own C library (../../libc), installed with PREFIX=/usr: the
# C library of a Shall system.  Linked statically by default; -B dynamic
# uses libc.so, the library that is also the dynamic linker (built only
# when gcc was at hand: see bootstrap.sh -s).
include /usr/include
libdir /usr/lib
crt1 crt1.o
crti crti.o
crtn crtn.o
interp /usr/lib/libc.so
link static
