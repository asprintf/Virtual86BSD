+static int
+ptsdrv_ioctl(struct tty *tp, u_long cmd, caddr_t data, struct thread *td)
+{
+
+	/* No line to hold a break on: tcsendbreak() takes no action (POSIX). */
+	switch (cmd) {
+	case TIOCSBRK:
+	case TIOCCBRK:
+		return (0);
+	}
+	return (ENOIOCTL);
+}
