# Adapted for V86BSD from NetBSD lib/libterminfo/genhash (revision 1.9).
# Changes: a binary search over an index sorted by name instead of the
# perfect hash of nbperf(1), which V86BSD does not have.

# Generate string tables for our terminfo strings in term.h, and a sorted
# index of them for the lookups.

set -e
: ${TOOL_AWK:=awk}
: ${TOOL_SED:=sed}
: ${TOOL_SORT:=sort}

TERMH=${1:-term.h}

genent()
{
	name=$1 NAME=$2

	# Calculate the maximum word length plus terminator
	len=$($TOOL_SED -e "1,/enum TI${NAME}/d" -e '/};/,$d' \
            -e 's/.*TICODE_\([^,]*\).*/\1X/' $TERMH | \
	    $TOOL_AWK \
	    'BEGIN {L=0} {if (length($1)>L) L=length($1)} END {print L}')

	echo
	echo "static const char _ti_${name}ids[][${len}] = {"
	$TOOL_SED -e "1,/enum TI${NAME}/d" -e '/};/,$d' \
            -e 's/.*TICODE_\([^,]*\).*/	"\1",/' $TERMH
	echo "};"
	echo
	echo "static const unsigned short _ti_${name}sorted[] = {"
	$TOOL_SED -e "1,/enum TI${NAME}/d" -e '/};/,$d' \
	    -e 's/.*TICODE_\([^,]*\).*/\1/' $TERMH | \
	    $TOOL_AWK '{ print $1, NR - 1 }' | LC_ALL=C $TOOL_SORT -k 1,1 | \
	    $TOOL_AWK '{ print "\t" $2 "," }'
	echo "};"

	cat <<EOF2

const char *
_ti_${name}id(ssize_t idx)
{

	if ((size_t)idx >= __arraycount(_ti_${name}ids))
		return NULL;
	return _ti_${name}ids[idx];
}

ssize_t
_ti_${name}index(const char *key)
{
	size_t lo, hi, mid;
	int c;

	lo = 0;
	hi = __arraycount(_ti_${name}sorted);
	while (lo < hi) {
		mid = lo + (hi - lo) / 2;
		c = strcmp(key, _ti_${name}ids[_ti_${name}sorted[mid]]);
		if (c == 0)
			return _ti_${name}sorted[mid];
		if (c < 0)
			hi = mid;
		else
			lo = mid + 1;
	}
	return -1;
}
EOF2
}

cat <<EOF2
/* DO NOT EDIT
 * Automatically generated from term.h */

#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <term_private.h>
#include <term.h>
EOF2

genent flag FLAG
genent num NUM
genent str STR
