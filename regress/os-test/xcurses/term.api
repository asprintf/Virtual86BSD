#include <term.h>
# X/Open Curses, Issue 4, Version 2 (SUSv2): the <term.h> page, and the
# capabilities' variable names of its Terminfo Source Format page; where
# X/Open Curses, Issue 7 changed a declaration, Issue 7's ([XCurses7]).
[SUSv2] typedef TERMINAL
[SUSv2] typedef bool
[SUSv2] external cur_term: TERMINAL *cur_term;
# Functions (they may also be macros)
[SUSv2] maybe_define function del_curterm: int del_curterm(TERMINAL *);
[SUSv2] maybe_define function putp: int putp(const char *);
[SUSv2] maybe_define function restartterm: int restartterm(char *, int, int *);
[SUSv2] maybe_define function set_curterm: TERMINAL *set_curterm(TERMINAL *);
[SUSv2] maybe_define function setupterm: int setupterm(char *, int, int *);
[SUSv2] maybe_define function tgetent: int tgetent(char *, const char *);
[SUSv2] maybe_define function tgetflag: int tgetflag(char *);
[SUSv2] maybe_define function tgetnum: int tgetnum(char *);
[SUSv2] maybe_define function tgetstr: char *tgetstr(char *, char **);
[SUSv2] maybe_define function tgoto: char *tgoto(char *, int, int);
[XCurses7] maybe_define function tigetflag: int tigetflag(const char *);
[XCurses7] maybe_define function tigetnum: int tigetnum(const char *);
[XCurses7] maybe_define function tigetstr: char *tigetstr(const char *);
[XCurses7] maybe_define function tparm: char *tparm(const char *, long, long, long, long, long, long, long, long, long);
[SUSv2] maybe_define function tputs: int tputs(const char *, int, int (*)(int));
