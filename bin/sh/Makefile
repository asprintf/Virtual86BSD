# sh - shell, the standard command language interpreter (POSIX.1-2024)
#
# Targets: all (the default), test, difftest, install, clean.
#
# The parsers are generated by yacc (sh.y: the shell grammar; arith.y:
# arithmetic expansion) and the arithmetic scanner by lex (arith.l).
# They are generated in the build (not part of the sources).

.POSIX:

CFLAGS   = -O2
LDFLAGS  =
PREFIX   = /usr/local
BINDIR   = $(PREFIX)/bin
# yacc and lex: this collection's own, built in ../../usr.bin/yacc and ../../usr.bin/lex when
# they are not there yet; make YACC=... LEX=... names others.
YACC     = ../../usr.bin/yacc/yacc
LEX      = ../../usr.bin/lex/lex

# STDFLAGS: more options for the compiler, none needed (the sources are
# C11 with POSIX interfaces); with gcc or clang, for example,
# STDFLAGS="-std=c11 -Wall -Wextra".  CC is make's own (POSIX: c17).
STDFLAGS =
LDLIBS   =

PROG     = sh
OBJS     = main.o util.o var.o input.o parser.o sh.tab.o expand.o \
	   arith.tab.o arith_scan.o exec.o jobs.o builtins.o bltin2.o edit.o

all: $(PROG)

$(PROG): $(OBJS)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)

$(OBJS): sh.h
parser.o sh.tab.o: parse.h sh.tab.h
arith.tab.o arith_scan.o: arith.h arith.tab.h

.c.o:
	$(CC) $(STDFLAGS) $(CFLAGS) -c $<

sh.tab.c sh.tab.h: sh.y
	@case "$(YACC)" in ../../usr.bin/yacc/yacc) test -x $(YACC) || (cd ../../usr.bin/yacc && $(MAKE));; esac
	$(YACC) -d -p shy -b sh sh.y

arith.tab.c arith.tab.h: arith.y
	@case "$(YACC)" in ../../usr.bin/yacc/yacc) test -x $(YACC) || (cd ../../usr.bin/yacc && $(MAKE));; esac
	$(YACC) -d -b arith arith.y

arith_scan.c: arith.l
	@case "$(LEX)" in ../../usr.bin/lex/lex) test -x $(LEX) || (cd ../../usr.bin/lex && $(MAKE));; esac
	$(LEX) -t arith.l > arith_scan.c

test: all
	cd ../../regress/bin/sh && $(MAKE) test

# compares with other implementations; needs
#   dash, bash, yash, busybox and mksh (the majority is the reference)
difftest: all
	cd ../../regress/bin/sh && $(MAKE) difftest

# kill.sh becomes the kill utility (the only intrinsic utility the exec
# family must reach, XCU 1.6)
install: all
	mkdir -p $(DESTDIR)$(BINDIR)
	cp $(PROG) $(DESTDIR)$(BINDIR)/$(PROG)
	cp kill.sh $(DESTDIR)$(BINDIR)/kill
	chmod 755 $(DESTDIR)$(BINDIR)/kill

clean:
	rm -f $(PROG) $(OBJS) sh.tab.c sh.tab.h arith.tab.c arith.tab.h arith_scan.c

.PHONY: all test difftest install clean
