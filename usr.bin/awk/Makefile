# awk - pattern scanning and processing language (POSIX.1-2024)
#
# Targets: all (the default), test, difftest, install, clean.
#
# The parser is generated by yacc from awk.y and the scanner by lex from
# awk.l, in the build (the generated files are not part of the sources).

.POSIX:

CFLAGS   = -O2
LDFLAGS  =
PREFIX   = /usr/local
BINDIR   = $(PREFIX)/bin
# yacc and lex: this collection's own, built in ../../usr.bin/yacc and ../../usr.bin/lex when
# they are not there yet; make YACC=... LEX=... names others.
YACC     = ../../usr.bin/yacc/yacc
LEX      = ../../usr.bin/lex/lex

# STDFLAGS: more options for the compiler, none needed (the sources are
# C11 with POSIX interfaces); with gcc or clang, for example,
# STDFLAGS="-std=c11 -Wall -Wextra".  CC is make's own (POSIX: c17).
STDFLAGS =
LDLIBS   = -lm

PROG     = awk
OBJS     = main.o parse.o awk.tab.o lex.o run.o lib.o

all: $(PROG)

$(PROG): $(OBJS)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)

$(OBJS): awk.h
parse.o awk.tab.o lex.o: parse.h awk.tab.h

.c.o:
	$(CC) $(STDFLAGS) $(CFLAGS) -c $<

awk.tab.c awk.tab.h: awk.y
	@case "$(YACC)" in ../../usr.bin/yacc/yacc) test -x $(YACC) || (cd ../../usr.bin/yacc && $(MAKE));; esac
	$(YACC) -d -b awk awk.y

lex.c: awk.l
	@case "$(LEX)" in ../../usr.bin/lex/lex) test -x $(LEX) || (cd ../../usr.bin/lex && $(MAKE));; esac
	$(LEX) -t awk.l > lex.c

test: all
	cd ../../regress/usr.bin/awk && $(MAKE) test

# compares with other implementations; needs
#   gawk (REF="gawk --posix" by default)
difftest: all
	cd ../../regress/usr.bin/awk && $(MAKE) difftest

install: all
	mkdir -p $(DESTDIR)$(BINDIR)
	cp $(PROG) $(DESTDIR)$(BINDIR)/$(PROG)

clean:
	rm -f $(PROG) $(OBJS) awk.tab.c awk.tab.h lex.c

.PHONY: all test difftest install clean
