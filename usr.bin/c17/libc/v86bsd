# V86BSD's own C library (../../libc), installed with PREFIX=/usr: the
# C library of a V86BSD system.  Linked dynamically by default, with
# libc.so, the library that is also the dynamic linker; -B static links
# libc.a.
include /usr/include
include /usr/local/include    # where third-party software goes (ports/)
libdir /usr/lib
libdir /usr/local/lib
crt1 crt1.o
crti crti.o
crtn crtn.o
interp /usr/lib/libc.so
link dynamic
