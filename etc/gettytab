# /etc/gettytab - what getty(8) does for a line: one entry per kind of line,
# named in /etc/ttys (`getty std.115200 tty00').  The format is termcap's:
# names separated by |, then capabilities between colons; a backslash at the
# end of a line continues it.  What an entry lacks comes from its tc= entry
# and then from `default'.
#
#   sp#N   the speed in baud          im=    the banner before the prompt:
#   lm=    the prompt (`login: ')            %h host %t line %s system
#   lo=    the login program                 %m machine %r release %d date
#   to#N   seconds to answer, or getty ends  %% a percent
# Escapes in strings: \r \n \t \b \f \e \\ \: \ooo (octal) and ^X (control X).

default:\
	:im=\r\nVirtual/86 BSD/%m (%h) (%t)\r\n\r\n:sp#9600:

std.9600|9600-baud:\
	:sp#9600:
std.19200|19200-baud:\
	:sp#19200:
std.38400|38400-baud:\
	:sp#38400:
std.57600|57600-baud:\
	:sp#57600:
std.115200|115200-baud:\
	:sp#115200:
