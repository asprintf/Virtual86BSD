# /etc/master.passwd - the users and their password hashes (mode 0600, root's):
#   name:passwd:uid:gid:class:change:expire:gecos:home:shell
# /etc/passwd is the same without the hashes.  An empty passwd is an account
# that needs none; `*' (or `!') is one nobody can log in to.  Change a password
# with passwd(1); a hash is crypt(3), `$6$salt$...' (SHA-512).
#
# root's password is `root' until `passwd' changes it (make release ROOTPW=...
# builds a root with another); the salt is fixed so that builds are
# reproducible.
root:$6$v86bsd$Eh5hehXLgKslvip67JYxBNugIr3L8HhKZyYVbM/EQMdfBBDxEz4PqQAFx7XFiUjq6F0cY6Z6rtTT/p.DpyLq0/:0:0::0:0:root:/root:/bin/sh
nobody:*:65534:65534::0:0:nobody:/nonexistent:/bin/sh
