# /etc/fstab - the file systems mount(8) -a mounts at boot: special, directory,
# type, options, dump frequency, fsck pass (0: fsck leaves it alone, as it must
# a type it has no fsck_TYPE for, such as ext2).  The kernel itself mounts / (and /dev, a devfs),
# read-only; rc makes it writable with mount -uw / after fsck.
/dev/gpt/rootfs / ufs ro 1 1
