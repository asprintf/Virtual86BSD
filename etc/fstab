# /etc/fstab - the file systems mount(8) -a mounts at boot: special, directory,
# type, options, dump frequency, fsck pass (0: fsck leaves it alone, as it must
# a type it has no fsck_TYPE for, such as ext2).  The kernel itself mounts / (and /dev and
# /proc); mount -uw / makes it writable.
/dev/disk0s1 / ffs rw 1 1
