SQLite 3.54.1, source tree (git tag version-3.54.1 of github.com/sqlite/sqlite,
= sqlite-src-3540100.zip), for POSIX.1-2024: gettimeofday(), <utime.h> and
<memory.h> are not there.  Applied by ports/sqlite/build.sh (patch -p1).

diff -ru a/autosetup/jimsh0.c b/autosetup/jimsh0.c
--- a/autosetup/jimsh0.c	2026-11-04 16:07:51.958572837 +0100
+++ b/autosetup/jimsh0.c	2026-11-04 16:17:08.853532911 +0100
@@ -8047,7 +8047,16 @@
     else
 #endif
     {
+#if defined(_POSIX_VERSION) && _POSIX_VERSION >= 202405L
+        /* gettimeofday() is gone from POSIX.1-2024: clock_gettime() */
+        struct timespec rt;
+
+        clock_gettime(CLOCK_REALTIME, &rt);
+        tv.tv_sec = rt.tv_sec;
+        tv.tv_usec = rt.tv_nsec / 1000;
+#else
         gettimeofday(&tv, NULL);
+#endif
 
         now = tv.tv_sec * 1000000LL + tv.tv_usec;
     }
